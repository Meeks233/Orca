/target
/docker-compose.local.yml
/data
/downloads

# Local dev/test containers — never part of the repo
/docker-compose.dev.yml

# Local Claude Code automation harness (rebuild/verify/push) — local-only
/CLAUDE.md
/AGENT.md
/.claude/
/.opencode/
/.mcp.json
.cc-*

# scripts/ is mostly that same local harness, so it is ignored wholesale — but
# the release tooling belongs to the project, not to one machine. Listed with
# `/scripts/*` rather than `/scripts/` so git still descends and sees these two.
/scripts/*
!/scripts/release.zsh
!/scripts/check-versions.sh

# Local promo screenshots captured by scripts/grab-shots.zsh
/promo-shots/

# Frontend build tooling deps (esbuild/typescript) — output in web/ is committed
/frontend/node_modules

# Android release credentials and generated distribution artifacts
*.jks
*.keystore
*.p12
*.pfx
**/keystore.properties
**/key.properties
**/play-service-account*.json
/dist/
